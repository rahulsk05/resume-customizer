APP_NAME=Resume Customizer API
APP_ENV=development

DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/resume_customizer

JWT_SECRET=replace-with-a-secure-secret
JWT_EXPIRES_IN_MINUTES=60

JWT_COOKIE_NAME=access_token
JWT_COOKIE_SECURE=false
JWT_COOKIE_HTTP_ONLY=true
JWT_COOKIE_SAME_SITE=lax

GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=your-selected-gemini-model
GEMINI_EMBEDDING_MODEL=your-selected-embedding-model
GEMINI_EMBEDDING_DIMENSION=embedding-dimension-of-selected-embedding-model

FRONTEND_URL=http://localhost:3000